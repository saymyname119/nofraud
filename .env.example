# ── Razorpay (Test Mode) ──────────────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Get from: Razorpay Dashboard → Settings → Webhooks → Add Webhook → Secret field
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./fraudspike.db

# ── Ngrok (webhook tunnel) ────────────────────────────────────────────────────
# Once you run: ngrok http 8000
# Paste the https URL here + /webhook and update Razorpay Dashboard
NGROK_URL=https://placeholder.ngrok-free.app

# ── Redis (optional — velocity features stretch goal) ─────────────────────────
# Leave empty to use SQLite-based velocity counters instead
REDIS_URL=
